[Unit]
Description=Backup Planner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backup-planner
Group=backup-planner
WorkingDirectory=/opt/backup-planner
EnvironmentFile=/etc/backup-planner/environment
ExecStart=/usr/bin/node dist-server/server/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/backup-planner

[Install]
WantedBy=multi-user.target
